flowchart LR
    Start(["1️⃣ Merchant finds<br/>SAMURAI TAX"]) --> Install(["2️⃣ Installs app"])
    Install --> Consent{{"3️⃣ Approves<br/>consent"}}
    Consent --> Redirect(["4️⃣ Embedded in<br/>Shopify Admin"])
    Redirect --> HMAC[/"5️⃣ Backend verifies<br/>it's really Shopify"/]
    HMAC --> Token[/"6️⃣ Session token<br/>exchanged"/]
    Token --> Save[("7️⃣ Access token<br/>saved & encrypted")]
    Save --> LoginPage(["8️⃣ Dashboard login<br/>shown, embedded"])

    LoginPage --> HasAccount{"9️⃣ Has account?"}

    HasAccount -->|Yes| LoginA(["🔟 Logs in"])
    LoginA --> LinkA[/"1️⃣1️⃣ Store linked<br/>to company"/]
    LinkA --> DashA(["1️⃣2️⃣ Live dashboard<br/>shown in Shopify"])

    HasAccount -->|No| ContactB(["🔟 Clicks<br/>'Contact us'"])
    ContactB --> LeadB[("1️⃣1️⃣ Lead<br/>captured")]
    LeadB --> WaitB(["1️⃣2️⃣ TAIMATSU<br/>creates account"])
    WaitB -.->|"reopens app"| LoginPage

    style Start fill:#ff6b6b,stroke:#c92a2a,color:#fff
    style DashA fill:#20c997,stroke:#0ca678,color:#fff
    style WaitB fill:#ffd43b,stroke:#f08c00,color:#000
    style HasAccount fill:#845ef7,stroke:#5f3dc4,color:#fff
    style Consent fill:#845ef7,stroke:#5f3dc4,color:#fff
    style Save fill:#4dabf7,stroke:#1971c2,color:#fff
    style LeadB fill:#4dabf7,stroke:#1971c2,color:#fff
